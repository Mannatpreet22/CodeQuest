// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// // clerk
model User {
  id           String       @id // Clerk user ID
  username     String?      // Optional username from Clerk
  email        String       @unique
  firstName    String?      // First name from Clerk
  lastName     String?      // Last name from Clerk
  imageUrl     String?      // Profile image from Clerk
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  // Relations
  submissions  Submission[] // A user can make many submissions
}


model Question {
  id         String       @id @default(uuid())
  title      String       @unique
  body       String       
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  
  // Relations
  testcases       TestCase[]
  examples        Example[]
  templateCodes   TemplateCode[]
  submissions     Submission[]
}

model TestCase {
  id           Int        @id @default(autoincrement())
  inputs       Json
  expected     Json
  isVisible    Boolean    @default(true)  // true = visible to users, false = hidden test cases

  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  testCaseInputs TestCaseInput[]

  @@index([questionId])
  @@index([questionId, isVisible])
}

model TestCaseInput {
  id           Int        @id @default(autoincrement())
  testCase     TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseId   Int
  position     Int
  name         String?
  value        Json

  @@index([testCaseId, position])
}


model Example {
  id          Int    @id @default(autoincrement())
  inputData   String
  outputData  String
  explanation String?
  
  // Foreign key
  questionId  String
  
  // Relations
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TemplateCode {
  id                    String               @id @default(uuid())
  driverCode            String
  questionId            String
  programmingLanguageId String
  
  // Relations
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
}


model Submission {
  id                  String               @id @default(uuid())
  codeText            String
  status              String              // e.g., "PENDING", "AC", "WA", "TLE"
  runtime             Int?                // in milliseconds
  memoryUsed          Int?                // in kilobytes
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Foreign keys
  userId                String
  questionId            String
  language              String
  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
